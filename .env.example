# Pulse CRM environment variables
# Copy to .env.local and fill in values

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Server-only. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# --- Google Sheet sync (optional) ---
# Google Apps Script web app URL that appends lead rows to your master sheet.
# Leave empty to disable sync silently.
SHEETS_WEBHOOK_URL=

# --- External REST API (optional) ---
# Bearer key for /api/ext/leads endpoints. Leave empty to disable the API.
API_KEY=

# --- Founder seed script (npm run seed:founder) ---
FOUNDER_EMAIL=
FOUNDER_PASSWORD=
